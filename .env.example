# IterResearch - Environment Configuration Example

# =============================================================================
# Provider-based LLM Configuration
# =============================================================================
# For Aliyun provider, set these environment variables:
export ALIYUN_LLM_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
export ALIYUN_API_KEY="your-aliyun-api-key"

# For DeepSeek provider, set these environment variables:
export DEEPSEEK_LLM_URL="https://api.deepseek.com/v1/chat/completions"
export DEEPSEEK_API_KEY="your-deepseek-api-key"

# =============================================================================
# Default / OpenAI-compatible provider
# =============================================================================
# Used when no --provider is specified or when provider is 'default'
export LLM_URL="http://127.0.0.1:10086/v1/chat/completions"
export OPENAI_API_KEY="your-openai-api-key"

# =============================================================================
# Search API Configuration
# =============================================================================
# Google Search API (via SerpAPI)
export SEARCH_API_KEY="your-serpapi-key"
export SEARCH_API_URL="https://serpapi.com/search"
export SEARCH_API_KEY_BACKUP_1="your-serpapi-backup-key-1"
export SEARCH_API_KEY_BACKUP_2="your-serpapi-backup-key-2"

# Google Scholar API
export SCHOLAR_API_KEY="your-serpapi-key"
export SCHOLAR_API_URL="https://serpapi.com/search"

# Baidu Qianfan Search API
export BAIDU_API_KEY="your-baidu-qianfan-key"
export BAIDU_URL="https://qianfan.baidubce.com/v2/ai_search/web_search"

# Aliyun IQS API
export IQS_API_KEY="your-aliyun-iqs-key"
export IQS_BASE_URL="https://cloud-iqs.aliyuncs.com"

# =============================================================================
# Webpage Reading Configuration
# =============================================================================
# Jina Reader API for webpage content extraction
export JINA_API_KEY="your-jina-api-key"

# ScraperAPI for proxy-based web scraping
export SCRAPER_API_KEY="your-scraper-api-key"

# =============================================================================
# Python Sandbox Configuration
# =============================================================================
# Sandbox endpoint for code execution
export SANDBOX_ENDPOINTS="http://127.0.0.1:8080"

# =============================================================================
# Tokenizer Configuration
# =============================================================================
# Path to tokenizer model for token counting
export TOKENIZER_PATH="Qwen/Qwen2.5-7B-Instruct"

# =============================================================================
# Agent Configuration
# =============================================================================
export MAX_TURN="25"
export MAX_FORMAT_RETRIES="5"
export MAX_WORKERS="1"
export MAX_OBSERVATION_TOKENS="32000"
export MAX_WEBPAGE_TOKENS="48000"
